{
  "name": "vibed-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsc --noEmit && next build",
    "lint": "eslint . --config eslint.config.mjs",

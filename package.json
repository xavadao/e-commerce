    "deploy": "pnpm build && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.20",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^26.6.5",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "postcss": "8.5.3",
    "tailwindcss": "^4.2.2",
    "typescript": "6.0.3",
    "wrangler": "4.77.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.13.0",
  "license": "MIT"
